# Copy to .env, fill in, then start with:  npm start
# (npm start loads .env automatically)

# --- Basics ---
PORT=3000
APP_URL=http://localhost:3000          # public address, used in email links (https://... in production)
APP_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=91                # added to phone numbers typed without +country code

# --- First admin account (created on start if it doesn't exist) ---
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Ashram Admin

# --- Contact details shown on the visitor "Contact" page ---
CONTACT_PHONE=+91 80 1234 5678
CONTACT_WHATSAPP=+918012345678
CONTACT_EMAIL=visits@example.org
CONTACT_ADDRESS=Main Ashram Office
ADMIN_NOTIFY_EMAIL=                    # optional: email the team on new requests/messages

# --- Email (any SMTP provider: Gmail, Zoho, SendGrid, Amazon SES, ...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Meet Gurudev <visits@example.org>"

# --- WhatsApp (Meta WhatsApp Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=appointment_update
WHATSAPP_TEMPLATE_LANG=en

# --- Timing ---
QR_LEAD_MINUTES=10                     # entry QR appears this many minutes before the meeting
MAX_ACTIVE_APPOINTMENTS=3              # upcoming appointments one visitor may hold
