# Copy this file to .env, fill it in, then run:  npm start

# --- Basics ---
PORT=3000
APP_URL=http://localhost:3000          # your public address (https://...) once the app is online
APP_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=91                # added to numbers typed without +country code

# --- First admin (logs in with this WhatsApp number and a code) ---
ADMIN_PHONE=98765 43210
ADMIN_NAME=Ashram Admin

# --- Visiting hours: Morning, Afternoon, Evening (24-hour clock) ---
# The QR pass is sent, and becomes valid, at the start of each session.
SESSION_TIMES=08:00-13:00,13:00-16:00,16:00-20:00
REMINDER_TIME=18:00                    # day-before reminder
GREETING_TIME=07:00                    # greeting on the day of the visit

# --- Contact details shown to visitors under "Need help?" ---
CONTACT_PHONE=+91 80 1234 5678
CONTACT_WHATSAPP=+918012345678
CONTACT_ADDRESS=Main Ashram Office

# --- WhatsApp (Meta WhatsApp Cloud API) ---
# Until these are filled in, login codes and messages are printed in the terminal.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=login_code
WHATSAPP_TEMPLATE=appointment_update
WHATSAPP_PASS_TEMPLATE=entry_pass
WHATSAPP_TEMPLATE_LANG=en

# --- Only for trying the app on your own computer ---
# Shows the login code on screen when WhatsApp isn't set up. Never use online.
SHOW_OTP_ON_SCREEN=1
