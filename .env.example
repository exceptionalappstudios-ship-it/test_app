# Copy this file to .env, fill it in, then run:  npm start

# --- Basics ---
PORT=3000
APP_URL=http://localhost:3000          # your public address (https://...) once the app is online
APP_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=91                # added to every 10-digit mobile number

# --- Admins are the people in src/references.js. ADMIN_PASSWORD replaces their built-in password ---
# ADMIN_PASSWORD=choose-a-strong-password

# --- Visiting hours: Morning, Evening (24-hour clock) ---
# The QR pass is sent when a visit is confirmed and works any time on the visit day.
SESSION_TIMES=08:00-13:00,16:00-20:00
REMINDER_TIME=18:00                    # day-before reminder
GREETING_TIME=07:00                    # greeting on the day of the visit

# --- Contact details shown to visitors under "Need help?" ---
CONTACT_PHONE=+91 80 1234 5678
CONTACT_WHATSAPP=+918012345678
CONTACT_ADDRESS=Main Ashram Office

# --- WhatsApp ---
# Keep these secret: set them only in the host's variables, never in the code.
# Until WHATSAPP_TOKEN is set, login codes are shown on screen and printed here.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# mart2meta provider: its "YOURUID" (leave empty for Meta's Cloud API directly)
WHATSAPP_VENDOR_UID=
WHATSAPP_OTP_TEMPLATE=appointment_test_ashram
# Optional templates for updates and passes (field_1 = title, field_2 = message)
WHATSAPP_TEMPLATE=
WHATSAPP_PASS_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# --- Only for trying the app on your own computer ---
# Shows the login code on screen when WhatsApp isn't set up. Never use online.
SHOW_OTP_ON_SCREEN=1
